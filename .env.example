# ─────────────────────────────────────────────────────────────
# Hypodermical Benelux — environment variables
# Copy to `.env` for local `vercel dev`, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────

# ─── Supabase ───────────────────────────────────────────────
# Project URL + anon (public) key are also hard-referenced in the
# browser via /assets/js/supabase-config.js — keep them in sync.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER ONLY. Never expose to the browser.
# Used by /api functions to verify B2B sessions and read trade prices.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ─── Stripe ─────────────────────────────────────────────────
# Secret key — SERVER ONLY (used by /api/create-checkout-session).
STRIPE_SECRET_KEY=sk_live_or_test_xxx

# Publishable key — also referenced in the browser via
# /shop/assets/js/stripe-checkout.js (STRIPE_PUBLISHABLE_KEY).
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
